* text=auto
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.txt text eol=lf
# Keep analyzer output bytes identical to its frozen SHA-256 manifest.
results/tissue_loto/*.csv -text !eol
# Preserve recorded aggregate/supplement bytes across Windows and fresh clones.
results/synthetic_mechanisms/* -text !eol
manuscript_v1/bmc_additional_files/*.csv -text !eol
tables/scientific_revision_v1/* -text !eol
docs/scientific_revision_v1/*.csv -text !eol
docs/scientific_revision_v1/*.json -text !eol
manuscript_v1/bmc_additional_files_scientific_revision_v1/* -text !eol
manuscript_v1/*_scientific_revision_v1.csv -text !eol
# Derived reproduction inventories bind exact bytes; never normalize their SHA inputs.
docs/reproducibility_assets_v1/*.json -text !eol
docs/reproducibility_assets_v1/*.csv -text !eol

# Preserve byte-bound M08 copies and provenance records across clones.
manuscript_v1/bmc_additional_files_M08_v1/* -text !eol whitespace=cr-at-eol
docs/m08_v1/*.json -text !eol whitespace=cr-at-eol
docs/m08_v1/*.csv -text !eol whitespace=cr-at-eol
figures/manuscript_m08_v1/* -text !eol whitespace=cr-at-eol
scripts/render_m08_word.ps1 -text !eol whitespace=cr-at-eol
